# Zugang zum Sprachmodell für den Profilmining-Dienst (Betriebsarten B-D,
# siehe Code/profile_mining/README.md). Nur den Schlüssel hinter "=" eintragen,
# ohne Anführungszeichen und ohne Leerzeichen um das "=".

# --- Uni-LLM-API (Voreinstellung) ---------------------------------------
PROFILE_MINING_PROVIDER=uni
LLM_BASE_URL=https://chat-ai.academiccloud.de/v1
LLM_MODEL=gemma-4-31b-it
UNI_LLM_API_KEY=

# --- Alternativ ein kommerzieller Anbieter ------------------------------
# Oben PROFILE_MINING_PROVIDER auf mistral, openai oder anthropic setzen und
# die passende Zeile hier einkommentieren. Ohne *_MODEL gilt die Voreinstellung
# (mistral-small-latest, gpt-4o-mini, claude-haiku-4-5).
# MISTRAL_API_KEY=
# MISTRAL_MODEL=
# OPENAI_API_KEY=
# OPENAI_MODEL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
